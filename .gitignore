# ═══════════════════════════════════════════════════════════════════════════
# CodeToCost — .gitignore
# Canal B2B: Arquitetura de Automação, SaaS & IA (en-US)
# Regra de ouro: NUNCA versionar segredos, mídia gerada ou estado de runtime.
#
# Ordem importa: as regras de negação (linha iniciada por `!`) DEVEM vir
# depois das regras que pretendeam reverter. Git aplica a ÚLTIMA regra
# que casar com o caminho.
# ═══════════════════════════════════════════════════════════════════════════

# ── SEGREDOS (nunca commitar) ──────────────────────────────────────────────
.env
**/.env
*.env*
pipeline/core/.env
token.json
client_secret.json
client_secret*.json
credentials*.json
service-account*.json
*.pem
*.key
id_rsa
id_ed25519
.pypirc
.npmrc

# Streamlit / ferramentas locais podem guardar credenciais fora do `.env`
.streamlit/secrets.toml
**/secrets.toml

# Re-inclusões explícitas: o template de ambiente É versionado.
# (mantidas abaixo de `*.env*` para que tenham prioridade)
!.env.example
!**/.env.example
!**/.env.sample

# ── Node / Remotion ────────────────────────────────────────────────────────
node_modules/
remotion-app/node_modules/
dist/
build/
remotion-app/build/
out/
remotion-app/out/
remotion-app/remotion-output/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*$py.class
.venv/
venv/
env/
.venv-kokoro/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ── Cache de modelos ML (pesado; re-baixável) ──────────────────────────────
.hf_cache/
pipeline/.hf_cache/
hub/
models--*/
.cache/
.keras/
.torch/

# ── Mídia gerada pelo pipeline ─────────────────────────────────────────────
*.wav
*.mp3
*.mp4
*.mov
*.avi
*.mkv
*.flac
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg.tmp

# ── Estado de runtime / bancos ─────────────────────────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log

# ── Saída de render e assets por projeto ───────────────────────────────────
# SOMENTE o conteúdo é ignorado; o diretório em si permanece versionável
# para que o `.gitkeep` possa ser re-incluído.
projects/**/03_audio/*
!projects/**/03_audio/.gitkeep
projects/**/output/*
!projects/**/output/.gitkeep
projects/**/04_assets/*
!projects/**/04_assets/.gitkeep

# Timeline/props gerados pelo pipeline (a fonte é 02_spec/video_spec.json)
projects/**/timeline.json
projects/**/render_props.json

storage/
assets_library/
music_library/
blog_articles/
post_kits/
pinterest_queue/

# ── Backups e transitórios ─────────────────────────────────────────────────
*.bak
*.prev
*.orig
*.rej
*.tmp
*.temp
*~
.~lock.*
_v1_*/
_v2_*/
_v3_*/

# ── OS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.agent/
.agents/
.gemini/
.opencode/
.qwen/
.cursor/
.idea/
.vscode/
*.swp

# ── Tooling local ─────────────────────────────────────────────────────────
.playwright-mcp/
