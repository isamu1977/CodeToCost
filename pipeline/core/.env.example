# ─────────────────────────────────────────────────────────────────────────────
# CodeToCost — Environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env` (already gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (OpenRouter) ──────────────────────────────────────────────────────────
# Used by the script compiler and the market scraper.
# Create your key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Heavier model for research synthesis and script review:
MODEL_LITERARY=anthropic/claude-sonnet-5
# Cheap/fast model for scraping, classification and utility calls:
MODEL_UTILITY=google/gemini-2.5-flash

# ── TTS Provider Selection ───────────────────────────────────────────────────
# Active provider: "stepfun" (production default), "minimax", "kokoro" or "qwen"
TTS_PROVIDER=stepfun
TTS_ENGINE=stepfun

# ── TTS — StepFun StepAudio (Primary Production Engine) ────────────────────────
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/step_plan/v1
STEPFUN_MODEL=stepaudio-2.5-tts
STEPFUN_VOICE=magnetic-voiced-male
STEPFUN_SPEED=0.95

# ── TTS — MiniMax Speech API (Tier 2 fallback) ────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=speech-01-turbo
MINIMAX_VOICE_ID=English_male_narrator
MINIMAX_SPEED=0.95

# ── TTS — Fish Audio (Tier 3 fallback) ────────────────────────────────────────
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio/v1
FISH_AUDIO_MODEL=s2.1-pro

# ── TTS — Kokoro-82M (local, free, fastest) ───────────────────────────────────
# 82M params, ~10x faster than Qwen3-TTS on Apple Silicon (RTF ~0.34x on M1 Max).
# Voices: af_heart, af_bella, am_michael, am_adam, bm_george, ...
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_VOICE=am_michael
KOKORO_LANG=a

# ── TTS — Qwen3-TTS (alternative local engine) ────────────────────────────────
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_TTS_SPEAKER=Vivian
QWEN_TTS_INSTRUCT="Speak as a senior software engineer explaining architecture to a technical audience — clear, confident, unhurried"
QWEN_TTS_LANGUAGE=English
# "mps" for Apple Silicon, "cuda:0" for NVIDIA, "cpu" fallback:
QWEN_TTS_DEVICE=mps

# ── HuggingFace cache ─────────────────────────────────────────────────────────
# Where local models (Kokoro, faster-whisper) are cached.
# Default (empty) = ~/.cache/huggingface.
HF_HOME=

# ── Transcription (Faster-Whisper) ────────────────────────────────────────────
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
# "cpu" is fast enough for narration on Apple Silicon (int8).
WHISPER_DEVICE=cpu

# ── Brand / Channel ───────────────────────────────────────────────────────────
BRAND_DOMAIN=codetocost.com
BRAND_NAME=CodeToCost
YOUTUBE_CHANNEL_HANDLE=

# ── Storage (relative to pipeline/core/) ──────────────────────────────────────
STORAGE_DIR=./storage
ASSETS_LIBRARY_DIR=./assets_library
MUSIC_LIBRARY_DIR=./music_library
BLOG_ARTICLES_DIR=./blog_articles

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
