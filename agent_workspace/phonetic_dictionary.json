{
  "_comment": "CodeToCost — phonetic normalization dictionary applied to spoken_text BEFORE the TTS call. Prevents the English TTS engine from stumbling on acronyms, symbols and currency. Source of truth: MASTER_BLUEPRINT.md §3.",
  "_usage": "pipeline/core must load this and rewrite spoken_text per scene before synthesis.",
  "version": "1.0.0",
  "language": "en-US",
  "rules": {
    "n8n": "N-eight-N",
    "PostgreSQL": "Postgres Q-L",
    "SQLite": "S-Q-Lite",
    "SaaS": "Sass",
    "CLI": "C-L-I",
    "GUI": "gooey",
    "RAG": "R-A-G",
    "API": "A-P-I",
    "VPS": "V-P-S",
    "HTTP": "H-T-T-P",
    "JSON": "JAY-son",
    "YAML": "YAM-ul",
    "Docker": "Docker",
    "Kubernetes": "Koo-ber-net-eez",
    "OAuth": "oh-auth",
    "SSO": "S-S-O",
    "CRM": "C-R-M",
    "ERP": "E-R-P",
    "DX": "D-X",
    "CI/CD": "C-I C-D",
    "TTL": "T-T-L",
    "QPS": "Q-P-S",
    "e.g.": "for example",
    "i.e.": "that is",
    "vs.": "versus",
    "&": "and"
  },
  "numeric_patterns": [
    { "pattern": "\\$([0-9.,]+)/mo", "template": "{{amount}} dollars a month" },
    { "pattern": "\\$([0-9.,]+)/month", "template": "{{amount}} dollars a month" },
    { "pattern": "\\$([0-9.,]+)", "template": "{{amount}} dollars" },
    { "pattern": "([0-9.]+)k\\b", "template": "{{amount}} thousand" },
    { "pattern": "([0-9.]+)K\\b", "template": "{{amount}} thousand" },
    { "pattern": "([0-9.]+)M\\b", "template": "{{amount}} million" },
    { "pattern": "([0-9.]+)%", "template": "{{amount}} percent" },
    { "pattern": "([0-9.]+)x\\b", "template": "{{amount}} times" }
  ],
  "first_occurrence_spellout": ["RAG", "API", "SSO", "DX", "ERP", "CRM"]
}
